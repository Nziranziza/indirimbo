{
  "name": "indirimbo",
  "main": "expo-router/entry",
  "version": "1.7.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:web:deploy": "npm run build:web && tsx scripts/fix-web-paths.ts && tsx scripts/generate-song-pages.ts && tsx scripts/generate-playlist-pages.ts && tsx scripts/generate-spa-pages.ts && tsx scripts/generate-sitemap.ts && tsx scripts/relocate-vendor-assets.ts && cp public/404.html dist/404.html",
    "lint": "expo lint",
    "release": "npx eas-cli build --platform all --profile release",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "submit:all": "npm run submit:android && npm run submit:ios",
    "update": "npx eas-cli update --channel production",
    "ios:device": "expo run:ios --device",
    "android:device": "expo run:android --device",
    "ios:release": "expo run:ios --device --configuration release",
    "android:release": "expo run:android --device --variant release",
    "seo:indexnow": "tsx scripts/seo/submit-indexnow.ts",
    "seo:indexing-api": "tsx scripts/seo/submit-indexing-api.ts",
    "seo:verify-prepare": "tsx scripts/seo/verify-service-account.ts prepare",
    "seo:verify-confirm": "tsx scripts/seo/verify-service-account.ts confirm"
  },
  "dependencies": {
    "@aptabase/react-native": "^0.4.0",
    "@aptabase/web": "^0.5.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@sentry/react-native": "~7.11.0",
    "expo": "^57.0.8",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "fuse.js": "^7.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "expo-mcp": "~0.2.1",
    "google-auth-library": "^10.6.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
