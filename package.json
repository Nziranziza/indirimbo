{
  "name": "indirimbo",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:web:gh-pages": "npm run build:web && tsx scripts/fix-web-paths.ts && tsx scripts/generate-song-pages.ts && tsx scripts/generate-playlist-pages.ts && tsx scripts/generate-spa-pages.ts && tsx scripts/generate-sitemap.ts",
    "lint": "expo lint",
    "release": "npx eas-cli build --platform all --profile release",
    "submit:android": "npx eas-cli submit --platform android",
    "submit:ios": "npx eas-cli submit --platform ios",
    "update": "npx eas-cli update --channel production",
    "ios:device": "expo run:ios --device",
    "android:device": "expo run:android --device",
    "ios:release": "expo run:ios --device --configuration release",
    "android:release": "expo run:android --device --variant release",
    "seo:indexnow": "tsx scripts/seo/submit-indexnow.ts",
    "seo:indexing-api": "tsx scripts/seo/submit-indexing-api.ts",
    "seo:verify-prepare": "tsx scripts/seo/verify-service-account.ts prepare",
    "seo:verify-confirm": "tsx scripts/seo/verify-service-account.ts confirm"
  },
  "dependencies": {
    "@aptabase/react-native": "^0.4.0",
    "@aptabase/web": "^0.5.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@sentry/react-native": "~7.11.0",
    "expo": "^56.0.0",
    "expo-build-properties": "~56.0.15",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.12",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.7",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.3",
    "expo-symbols": "~56.0.5",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.17",
    "expo-web-browser": "~56.0.5",
    "fuse.js": "^7.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "google-auth-library": "^10.6.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
