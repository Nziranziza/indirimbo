# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Sentry crash reporting (client-side DSN; safe to expose in the bundle).
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (build-time secret — keep out of the bundle).
SENTRY_AUTH_TOKEN=

# Web session analytics (Microsoft Clarity) are disabled in dev by default so
# local sessions aren't recorded. Set to true to opt in while developing.
EXPO_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false
