# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Sentry crash reporting (client-side DSN; safe to expose in the bundle).
EXPO_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (build-time secret — keep out of the bundle).
SENTRY_AUTH_TOKEN=

# Aptabase analytics are disabled in dev by default to preserve quota.
# Set to true to track a test sample while developing.
EXPO_PUBLIC_ENABLE_ANALYTICS_IN_DEV=false
